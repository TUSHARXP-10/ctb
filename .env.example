# ======================================================================
#  Tushar.ai configuration. Copy to .env and fill in. Never commit .env.
# ======================================================================

# ---- Binance -----------------------------------------------------------
# demo    = Binance Demo Trading (keys from demo.binance.com > API Management)  <- recommended
# testnet = legacy futures testnet keys (testnet.binancefuture.com)
# paper   = no Binance keys needed: simulated account on real Binance prices
# live    = real money (also needs ALLOW_LIVE=true). Not recommended.
TRADING_MODE=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=
MARGIN_TYPE=ISOLATED

# ---- Claude (runs on your Pro/Max subscription, no API key) -------------
# agent = Claude Agent SDK with live tools (best)   cli = `claude -p` single pass   mock = rules, no Claude
BRAIN=agent
# sonnet (balanced), opus (strongest, uses more of your plan), haiku (fast/cheap) or a full model id
CLAUDE_MODEL=sonnet
# Let Claude search the web for news before trading
CLAUDE_ALLOW_WEB=true
CLAUDE_MAX_TURNS=40
# For servers/Docker: run `claude setup-token` on your computer and paste the token here.
# On your own computer you can leave it empty and just run `claude` once to log in.
CLAUDE_CODE_OAUTH_TOKEN=
# Removes ANTHROPIC_API_KEY from the environment so you are never billed per token
CLAUDE_USE_SUBSCRIPTION=true

# ---- Schedule ------------------------------------------------------------
# Claude thinks every N minutes (and when alerts, big moves or closed trades wake it)
CYCLE_MINUTES=15
MIN_CYCLE_GAP_MINUTES=3
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
SCAN_TOP_N=40

# ---- Risk limits (enforced in code, Claude cannot override them) ---------
RISK_PER_TRADE_PCT=1.5
MAX_LEVERAGE=10
DEFAULT_LEVERAGE=5
MAX_OPEN_POSITIONS=4
MAX_POSITION_MARGIN_PCT=25
MAX_DAILY_LOSS_PCT=6
MAX_TRADES_PER_DAY=12
MIN_REWARD_RISK=1.5
MIN_STOP_PCT=0.25
MAX_STOP_PCT=8
COOLDOWN_MINUTES_AFTER_LOSS=30
TM_GATE=true
TM_MIN_AVG_R=-0.15

# ---- Dashboard -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Set a password if the dashboard is reachable from other devices
DASHBOARD_PASSWORD=

# ---- Paper mode ------------------------------------------------------------
PAPER_START_BALANCE=10000
